/* Permission descriptions. iOS shows them in the SYSTEM language: the app language
   chosen in Settings cannot change them. */
"NSLocationWhenInUseUsageDescription" = "Only when you tap \"Use my location\": to suggest nearby places and mark the point on the map. Your position is sent to the place search service only at that moment. Bebômetro does not track your movements.";
"NSCameraUsageDescription" = "The camera is only used when you tap to photograph a label or menu. The photo stays on your device until you confirm it; confirmed photos are uploaded to the private area of your account.";
"NSPhotoLibraryUsageDescription" = "The photo library is only used so you can pick photos of labels and menus. The chosen photo stays on your device until you confirm it; confirmed photos are uploaded to the private area of your account.";
"NSMotionUsageDescription" = "Device motion is only used to tilt the beer in \"Tilt the glass\". Nothing is recorded.";
"NSPhotoLibraryAddUsageDescription" = "Used only when you choose to save an image you shared from Bebômetro to your photo library.";
"NSMicrophoneUsageDescription" = "The microphone is only used in the joke breathalyser, to sense how hard you blow. Sound is not recorded or sent.";
