<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (android:dataExtractionRules). Cloud backup (Google) leaves out what is sensitive
     or rebuilt from the account after sign-in; a device-to-device transfer keeps everything, so
     moving to a new phone does not lose unsynced records or unconfirmed photos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="sharedpref" path="bebometro_tracking.xml" />
        <exclude domain="file" path="app_flutter/outing_photos/" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
